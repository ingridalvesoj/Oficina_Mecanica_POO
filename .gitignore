.ruff_cache/
.mypy_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml

# Configurações locais e segredos (preservar exemplos)
.env
.env.*
!.env.example
!.env.*.example
.streamlit/secrets.toml

